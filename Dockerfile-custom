#
# Some bullshit to use newer JDK and ffmpeg before it hits upstream kagemomiji/airsonic-advanced
#
# - base is debian:testing
# - uses jlink to build jre
# - copies over the airsonic from upstream kagemomiji

ARG IMAGE_JAVA_VERSION=25

FROM docker.io/eclipse-temurin:${IMAGE_JAVA_VERSION} as jre-build
# Create a custom Java runtime
RUN $JAVA_HOME/bin/jlink \
         --add-modules java.base,java.sql,java.desktop,java.naming,java.management,java.security.jgss,java.instrument,jdk.unsupported,java.rmi \
         --strip-debug \
         --no-man-pages \
         --no-header-files \
         --compress=zip-6 \
         --output /javaruntime

FROM docker.io/debian:testing
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH "${JAVA_HOME}/bin:${PATH}"
COPY --from=jre-build /javaruntime $JAVA_HOME

# Copied from the upstream Dockerfile
# Updated to support locales (jjp)
RUN apt-get update \
    && apt-get install -y \
                       ffmpeg \
                       curl \
                       x264 \
                       x265 \
                       lame \
                       xmp \
                       bash \
                       fonts-dejavu \
                       gosu \
                       locales \
    && echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen \
    && locale-gen en_US.UTF-8 \ 
    && update-locale LANG=en_US.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


COPY --from=ghcr.io/kagemomiji/airsonic-advanced:edge-latest /app /app
COPY --from=ghcr.io/kagemomiji/airsonic-advanced:edge-latest /usr/local/bin/run.sh /usr/local/bin/run.sh
COPY --from=ghcr.io/kagemomiji/airsonic-advanced:edge-latest /usr/local/bin/entry.sh /usr/local/bin/entry.sh

RUN locale-gen en_US.UTF-8
RUN update-locale LANG=en_US.UTF-8

ENV AIRSONIC_PORT=4040 AIRSONIC_DIR=/var CONTEXT_PATH=/ UPNP_PORT=4041 PUID=0 PGID=0

EXPOSE $AIRSONIC_PORT
# Default DLNA/UPnP ports
EXPOSE $UPNP_PORT
EXPOSE 1900/udp

USER ${PUID}:${PGID}

VOLUME $AIRSONIC_DIR/airsonic $AIRSONIC_DIR/music $AIRSONIC_DIR/playlists $AIRSONIC_DIR/podcasts

HEALTHCHECK --interval=15s --timeout=3s CMD curl -f http://localhost:"$AIRSONIC_PORT""$CONTEXT_PATH"rest/ping || false

ENTRYPOINT ["entry.sh"]

